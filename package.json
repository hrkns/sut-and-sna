{
  "name": "sut-and-sna",
  "version": "0.2.3",
  "private": true,
  "packageManager": "yarn@1.22.15",
  "engines": {
    "node": "24.x",
    "yarn": ">=1.22 <2"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "algebra.js": "^0.2.6",
    "bootstrap": "^5.3.1",
    "gh-pages": "^6.0.0",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-bootstrap": "^2.8.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "7.21.11",
    "@playwright/test": "^1.53.0",
    "cross-env": "7.0.3",
    "eslint": "8.57.1",
    "eslint-config-react-app": "7.0.1",
    "prettier": "3.3.3"
  },
  "scripts": {
    "predeploy": "yarn build",
    "deploy": "gh-pages -d build",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "serve:e2e": "node scripts/serve-static.js build 3000",
    "test": "react-scripts test",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "format": "prettier --write \"**/*.{js,jsx,json,css,html,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,html,md,yml,yaml}\"",
    "test:unit": "cross-env CI=true react-scripts test --watch=false --runInBand --testPathPattern=unit.test.js",
    "test:integration": "cross-env CI=true react-scripts test --watch=false --runInBand --testPathPattern=integration.test.js",
    "test:coverage": "cross-env CI=true react-scripts test --watch=false --runInBand --coverage",
    "test:e2e": "yarn build && yarn test:e2e:run",
    "test:e2e:run": "node scripts/run-e2e.js",
    "test:e2e:headed": "yarn build && node scripts/run-e2e.js --headed",
    "test:e2e:install": "playwright install",
    "test:ci": "yarn validate",
    "validate": "yarn lint && yarn format:check && yarn test:coverage && yarn build && yarn test:e2e:run",
    "eject": "react-scripts eject"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/shared/**/*.js",
      "src/components/**/*.js",
      "src/App.js"
    ],
    "coverageThreshold": {
      "src/shared/**/*.js": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "src/components/**/*.js": {
        "branches": 70,
        "functions": 90,
        "lines": 80,
        "statements": 80
      },
      "src/App.js": {
        "branches": 80,
        "functions": 100,
        "lines": 90,
        "statements": 90
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "homepage": "https://hrkns.github.io/sut-and-sna"
}
